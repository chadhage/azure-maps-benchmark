HOST=127.0.0.1
PORT=3000
ENABLE_LIVE=false
# Azure Maps account uniqueId, NOT a subscription ID or an Entra application ID.
AZURE_MAPS_CLIENT_ID=
# Public-cloud endpoints only: global, us, or eu.
AZURE_MAPS_GEOGRAPHY=global
# Required before accepting browser traffic when HOST is not loopback.
# In App Service, the Bicep template enforces single-tenant Entra authentication.
REQUIRE_PLATFORM_AUTH=false
