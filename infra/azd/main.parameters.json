{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "entraApplicationClientId": { "value": "${ENTRA_APPLICATION_CLIENT_ID}" },
    "allowedEntraGroupObjectId": { "value": "${ALLOWED_ENTRA_GROUP_OBJECT_ID}" },
    "deployerObjectId": { "value": "${AZURE_DEPLOYER_OBJECT_ID}" },
    "budgetAlertEmail": { "value": "${BUDGET_ALERT_EMAIL}" },
    "webAppName": { "value": "${AZURE_WEB_APP_NAME}" },
    "mapsGeography": { "value": "${AZURE_MAPS_GEOGRAPHY}" }
  }
}
