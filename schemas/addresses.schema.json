{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smbc-poc:addresses:1.0",
  "title": "Azure Maps efficacy address dataset",
  "oneOf": [
    { "$ref": "#/$defs/cases" },
    { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "cases"], "properties": { "schemaVersion": { "const": "1.0" }, "cases": { "$ref": "#/$defs/cases" } } }
  ],
  "$defs": {
    "country": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
    "position": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }], "items": false },
    "text": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "address": { "type": "object", "minProperties": 1, "additionalProperties": false, "properties": { "addressLine": { "$ref": "#/$defs/text" }, "locality": { "$ref": "#/$defs/text" }, "adminDistrict": { "$ref": "#/$defs/text" }, "postalCode": { "$ref": "#/$defs/text" }, "countryRegion": { "$ref": "#/$defs/country" } } },
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["source"],
      "properties": { "source": { "$ref": "#/$defs/text" }, "noMatch": { "type": "boolean" }, "address": { "$ref": "#/$defs/address" }, "position": { "$ref": "#/$defs/position" }, "toleranceMeters": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 } },
      "oneOf": [
        { "required": ["noMatch"], "properties": { "noMatch": { "const": true } }, "not": { "anyOf": [{ "required": ["address"] }, { "required": ["position"] }, { "required": ["toleranceMeters"] }] } },
        { "properties": { "noMatch": { "const": false } }, "anyOf": [{ "required": ["address"] }, { "required": ["position"] }], "dependentRequired": { "position": ["toleranceMeters"], "toleranceMeters": ["position"] } }
      ]
    },
    "case": { "type": "object", "additionalProperties": false, "required": ["id", "query"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" }, "query": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }, "category": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" }, "countryRegion": { "$ref": "#/$defs/country" }, "coordinates": { "$ref": "#/$defs/position" }, "expected": { "$ref": "#/$defs/expected" } } },
    "cases": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/case" } }
  }
}
